# ============================================
#  MiniMall Docker 环境变量示例
#  复制为 .env 后填入真实值，docker-compose 会自动加载
# ============================================
#
# 编排文件（两份，配合使用）：
#   1) docker-compose-infra.yml  中间件：Nacos / RocketMQ / Seata（端口绑定 127.0.0.1）
#   2) docker-compose-apps.yml   应用：MySQL / Redis / 6 微服务 / Gateway
#
# 微服务版启动顺序：
#   cp .env.example .env  &&  填入 JWT_SECRET / DEEPSEEK_API_KEY 等
#   docker compose -f docker-compose-infra.yml up -d
#   docker compose -f docker-compose-apps.yml up -d --build
#
# 微服务端口（固定，不需在此配置，仅说明）：
#   gateway=8080  user=8081  product=8082  order=8083
#   payment=8084  chat=8085  ai=8086
#   （Nacos/RocketMQ/Seata 在容器内通过服务名访问，无需在此配置 host）

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=ChangeMe_RootPass_2026
MYSQL_PORT=3306
MYSQL_DATABASE=minimall

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_PASSWORD=ChangeMe_RedisPass_2026

# ---------- 后端服务端口 ----------
SERVER_PORT=8081

# ---------- DeepSeek (LLM) ----------
DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ---------- Embedding (RAG 向量化) ----------
# 留空 = 走本地 TF-IDF 降级方案（精度有限，但离线可用）
EMBEDDING_API_KEY=
# EMBEDDING_API_URL=https://api.deepseek.com/embeddings
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ---------- JWT ----------
# 【必填】必须 256 bit 随机字符串，openssl rand -base64 32 生成
# 所有微服务（gateway/user/product/order/payment/chat/ai/backend）共享同一密钥
# 留空或使用默认值将导致服务启动失败（application.yml 已无默认值兜底）
JWT_SECRET=<YOUR_256BIT_RANDOM_SECRET>
JWT_EXPIRATION=86400000

# ---------- 内部服务间调用令牌 ----------
# /api/internal/** 接口仅信任携带此令牌的 Feign 调用（防止外部直连微服务端口伪造内部请求）
# 所有微服务共享同一值；生产环境必须设为强随机串（openssl rand -base64 32）
# 留空 = 使用开发默认值 minimall-internal-token-dev（仅限本地调试）
# INTERNAL_TOKEN=<YOUR_INTERNAL_TOKEN>

# ---------- 微信小程序登录（生产必填，开发留空走 mock）----------
# 开发：两项都留空 → WechatLoginService 用 SHA256(code+JWT_SECRET) 生成稳定 mock openid
#       （任意 code 均可登录，仅供本地调试）
# 生产：填入小程序后台的 AppID 和 Secret，走真实 jscode2session API 换取 openid
#       配置后 user-service 自动切换生产模式，前端只传 code（不可传 openid）
# WECHAT_APPID=<YOUR_WECHAT_APPID>
# WECHAT_SECRET=<YOUR_WECHAT_SECRET>

# ---------- RAG ----------
RAG_ENABLED=true

# ---------- Nacos 鉴权（开发环境关闭，生产必填）----------
# 开发：NACOS_AUTH_ENABLE=false（其他不用填）
# 生产：NACOS_AUTH_ENABLE=true，并填以下三项
NACOS_AUTH_ENABLE=false
# NACOS_AUTH_TOKEN=<YOUR_NACOS_AUTH_TOKEN_256BIT>    # openssl rand -base64 48
# NACOS_AUTH_IDENTITY_KEY=serverIdentity
# NACOS_AUTH_IDENTITY_VALUE=security

# ---------- JVM 调优（可选） ----------
# JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -Xlog:gc*:file=/app/logs/gc.log:time

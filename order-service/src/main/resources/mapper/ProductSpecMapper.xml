<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.minimall.mapper.ProductSpecMapper">

    <!-- 乐观锁更新规格库存（扣减） -->
    <update id="updateStockById">
        UPDATE product_spec
        SET stock = stock - #{decrease}
        WHERE id = #{id} AND stock >= #{decrease}
    </update>

</mapper>
